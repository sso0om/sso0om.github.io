# 텍스트 파일은 항상 LF로 정규화
* text=auto eol=lf

# 마크다운, 설정 파일 명시
*.md text eol=lf
*.markdown text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.scss text eol=lf
*.css text eol=lf
*.html text eol=lf
*.rb text eol=lf
Gemfile text eol=lf

# 바이너리는 변환 대상에서 제외
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary